#!/bin/sh

echo "🔍 Pre-commit checks..."

# 1. Build check — MUST pass (catches broken JSX, missing imports, etc.)
echo "📦 Running build..."
bun run build > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Fix errors before committing."
  bun run build 2>&1 | grep -E 'error|Error'
  exit 1
fi
echo "✅ Build passed"

# 2. Lint staged files only
echo "🧹 Running lint-staged..."
bunx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ Lint failed. Fix errors before committing."
  exit 1
fi
echo "✅ Lint passed"

# 3. TypeScript check — BLOCKING
echo '🔎 Running TypeScript check...'
bunx tsc --noEmit
if [ $? -ne 0 ]; then
  echo '❌ TypeScript check failed. Fix errors before committing.'
  exit 1
fi
echo '✅ TypeScript check passed'

echo "✅ All checks passed. Committing..."
